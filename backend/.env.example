# ClauseScope — développement local uniquement
DATABASE_URL=sqlite:///./clauses_detector.db
ENVIRONMENT=development
AUTH_MODE=disabled
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
MAX_UPLOAD_SIZE_BYTES=10485760

# Pour protéger une instance privée, activez explicitement le mode basic et
# définissez des valeurs uniques hors du dépôt :
# AUTH_MODE=basic
# BASIC_USERNAME=
# BASIC_PASSWORD=
